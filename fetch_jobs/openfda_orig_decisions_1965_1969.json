    "limit": 1000,
    "max_pages": 12,
    "sleep": 0.4,
    "out_template": "decisions_{year}.json",
    "skip_existing": true,
    "_why": "Pre-1980 coverage expansion: 1965-1969 ORIG/AP decisions. Third block; proves feasibility back to 1968 furosemide ORIG-1 (V17-C11). Same filter, verbatim with manifest."
  }
