[
  {
    "type": "openfda_decisions",
    "id": "orig_decisions",
    "endpoint": "https://api.fda.gov/drug/drugsfda.json",
    "search_template": "submissions.submission_type:\"ORIG\" AND submissions.submission_status:\"AP\" AND submissions.submission_status_date:[{start} TO {end}]",
    "years": [1970, 1971, 1972, 1973, 1974],
    "limit": 1000,
    "max_pages": 12,
    "sleep": 0.4,
    "out_template": "decisions_{year}.json",
    "skip_existing": true,
    "_why": "Pre-1980 coverage expansion: 1970-1974 ORIG/AP decisions. Second block to reach 1000 new verified entries beyond 1980. Same filter as 1975-1979. Verbatim payloads with manifest SHA-256."
  }
]
