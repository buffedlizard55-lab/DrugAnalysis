[
  {
    "type": "openfda_supplements",
    "id": "eff_suppl",
    "endpoint": "https://api.fda.gov/drug/drugsfda.json",
    "search_template": "submissions.submission_type:\"SUPPL\" AND submissions.submission_class_code:\"EFFICACY\" AND submissions.submission_status:\"AP\" AND submissions.submission_status_date:[{start} TO {end}]",
    "years": [2000, 2001, 2002, 2003, 2004, 2005, 2006, 2007, 2008, 2009, 2010,
              2011, 2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019, 2020,
              2021, 2022, 2023, 2024, 2025, 2026],
    "limit": 1000,
    "max_pages": 12,
    "sleep": 0.4,
    "out_template": "suppl_{year}.json",
    "skip_existing": true
  }
]
